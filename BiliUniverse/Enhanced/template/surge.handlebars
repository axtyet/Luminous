#!name = {{@package 'displayName'}}
#!desc = {{inline (@package 'description')}}
#!openUrl = {{@package 'openUrl'}}
#!author = {{@package 'contributors'}}
#!homepage = {{@package 'homepage'}}
#!icon = {{@package 'icon'}}
#!category = {{@package 'organizationName'}}
#!date = {{now "yyyy-MM-dd HH:mm:ss"}}
#!version = {{version}}
#!arguments = {{{arguments}}}
#!arguments-desc = {{{argumentsDesc}}}

[Map Local]
^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/" status-code=200 header="Content-Type:text/html|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/index\.mjs(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/index.mjs" status-code=200 header="Content-Type:text/javascript|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/assets\/Biliverse_subject\.png(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/assets/Biliverse_subject.png" status-code=200 header="Content-Type:image/png|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/assets\/Enhanced_subject\.png(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/assets/Enhanced_subject.png" status-code=200 header="Content-Type:image/png|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/assets\/Global_subject\.png(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/assets/Global_subject.png" status-code=200 header="Content-Type:image/png|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/assets\/Redirect_subject\.png(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/assets/Redirect_subject.png" status-code=200 header="Content-Type:image/png|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/assets\/ADBlock_subject\.png(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/assets/ADBlock_subject.png" status-code=200 header="Content-Type:image/png|Cache-Control:no-store"
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/configs\/Enhanced(?:\?.*)?$ data-type=file data="https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/BiliBili.Enhanced.boxjs.json" status-code=200 header="Content-Type:application/json; charset=utf-8|Cache-Control:no-store|X-PreferencePanes-Version:{{version}}"

[Script]
PreferencePanes.Web = type=http-request, pattern=^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/(?:Enhanced\/?|assets\/(?:app|navigation)\.mjs)(?:\?.*)?$, script-path=https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/web.js
PreferencePanes.API = type=http-request, pattern=^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\/(?:get|set|delete))?\/?(?:\?.*)?$, requires-body=1, max-size=65536, script-path=https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js
📺 BiliBili.Enhanced.x.resource.show.tab.v2 = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\?, requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js, argument={{{scriptParams}}}
📺 BiliBili.Enhanced.show.v1.Mixture.RegionShortcut.request.grpc = type=http-request, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/request.bundle.js, argument={{{scriptParams}}}
📺 BiliBili.Enhanced.show.v1.Mixture.RegionList.response.grpc = type=http-response, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList$, requires-body=1, binary-body-mode=1, engine=webview, max-size=262144, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js, argument={{{scriptParams}}}
📺 BiliBili.Enhanced.x.v2.account.mine = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\?, requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js, argument={{{scriptParams}}}
📺 BiliBili.Enhanced.x.v2.region.index = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\?, requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js, argument={{{scriptParams}}}
📺 BiliBili.Enhanced.x.v2.channel.region.list = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\?, requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js, argument={{{scriptParams}}}

[MITM]
hostname = %APPEND% biliverse.github.io, app.bilibili.com, app.biliapi.net, grpc.biliapi.net
