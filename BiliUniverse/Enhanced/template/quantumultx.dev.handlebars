#[rewrite_local]
^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$ url echo-response text/html echo-response https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/home.html
^https:\/\/app\.bilibili\.com\/settings\/theme\.css(?:\?[^#]*)?$ url echo-response text/css echo-response https://biliverse.github.io/settings/theme.css
^https:\/\/app\.bilibili\.com\/settings\/home\.json(?:\?[^#]*)?$ url echo-response application/json echo-response https://biliverse.github.io/settings/home.json
^https:\/\/app\.bilibili\.com\/settings\/bridge\.mjs(?:\?[^#]*)?$ url echo-response text/javascript echo-response https://biliverse.github.io/settings/bridge.mjs
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/(?:get|set|delete)(?:\?.*)?$ url script-analyze-echo-response https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js
# Biliverse 本地设置
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\?.*)?$ url echo-response application/json\r\nX-PreferencePanes-Version: {{version}} echo-response https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/Biliverse.Enhanced.dev.PreferencePanes.json
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\? url script-response-body https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/response.dev.bundle.js
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut$ url script-request-body https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/request.dev.bundle.js
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList$ url script-response-body https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/response.dev.bundle.js
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\? url script-response-body https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/response.dev.bundle.js
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\? url script-response-body https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/response.dev.bundle.js
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\? url script-response-body https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/response.dev.bundle.js

#[mitm]
hostname = biliverse.github.io, app.bilibili.com, app.biliapi.net, grpc.biliapi.net
