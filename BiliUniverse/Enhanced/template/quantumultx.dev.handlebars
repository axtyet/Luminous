#[rewrite_local]
^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$ url echo-response text/html\r\nCache-Control: no-store echo-response https://biliverse.github.io/settings/index.html
^https:\/\/biliverse\.github\.io\/settings\/theme\.css(?:\?[^#]*)?$ url echo-response text/css\r\nCache-Control: no-store echo-response https://biliverse.github.io/settings/theme.css
^https:\/\/app\.bilibili\.com\/settings\/index\.mjs(?:\?[^#]*)?$ url echo-response text/javascript\r\nCache-Control: no-store echo-response https://biliverse.github.io/settings/index.mjs
^https:\/\/app\.bilibili\.com\/settings\/assets\/Biliverse_subject\.png(?:\?[^#]*)?$ url echo-response image/png\r\nCache-Control: no-store echo-response https://biliverse.github.io/settings/assets/Biliverse_subject.png
^https:\/\/app\.bilibili\.com\/settings\/assets\/Enhanced_subject\.png(?:\?[^#]*)?$ url echo-response image/png\r\nCache-Control: no-store echo-response https://biliverse.github.io/settings/assets/Enhanced_subject.png
^https:\/\/app\.bilibili\.com\/settings\/assets\/Global_subject\.png(?:\?[^#]*)?$ url echo-response image/png\r\nCache-Control: no-store echo-response https://biliverse.github.io/settings/assets/Global_subject.png
^https:\/\/app\.bilibili\.com\/settings\/assets\/Redirect_subject\.png(?:\?[^#]*)?$ url echo-response image/png\r\nCache-Control: no-store echo-response https://biliverse.github.io/settings/assets/Redirect_subject.png
^https:\/\/app\.bilibili\.com\/settings\/assets\/ADBlock_subject\.png(?:\?[^#]*)?$ url echo-response image/png\r\nCache-Control: no-store echo-response https://biliverse.github.io/settings/assets/ADBlock_subject.png
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/[a-zA-Z0-9_-]+\/?(?:\?[^#]*)?$ url echo-response text/html\r\nCache-Control: no-store echo-response https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/index.html
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/assets\/index\.mjs(?:\?[^#]*)?$ url echo-response text/javascript\r\nCache-Control: no-store echo-response https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/index.mjs
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/assets\/navigation\.mjs(?:\?[^#]*)?$ url echo-response text/javascript\r\nCache-Control: no-store echo-response https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/navigation.mjs
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/(?:get|set|delete)(?:\?.*)?$ url script-echo-response https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js
