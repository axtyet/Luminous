name: "{{@package 'displayName'}}"
desc: |-
  {{#each (split (@package 'description') "\n")}}
  {{{this}}}
  {{/each}}
openUrl: "{{@package 'openUrl'}}"
author: |-
  {{#each (@package 'contributors')}}
  {{this}}
  {{/each}}
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
category: "{{@package 'organizationName'}}"
date: "{{now "yyyy-MM-dd HH:mm:ss"}}"
version: "{{version}}"

http:
  mitm:
    - "biliverse.github.io"
    - "app.bilibili.com"
    - "app.biliapi.net"
    - "grpc.biliapi.net"
  url-rewrite:
    - ^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$ https://biliverse.github.io/settings/index.html transparent
    - ^https:\/\/app\.bilibili\.com\/settings\/index\.mjs(?:\?[^#]*)?$ https://biliverse.github.io/settings/index.mjs transparent
    - ^https:\/\/app\.bilibili\.com\/settings\/assets\/Biliverse_subject\.png(?:\?[^#]*)?$ https://biliverse.github.io/settings/assets/Biliverse_subject.png transparent
    - ^https:\/\/app\.bilibili\.com\/settings\/assets\/Enhanced_subject\.png(?:\?[^#]*)?$ https://biliverse.github.io/settings/assets/Enhanced_subject.png transparent
    - ^https:\/\/app\.bilibili\.com\/settings\/assets\/Global_subject\.png(?:\?[^#]*)?$ https://biliverse.github.io/settings/assets/Global_subject.png transparent
    - ^https:\/\/app\.bilibili\.com\/settings\/assets\/Redirect_subject\.png(?:\?[^#]*)?$ https://biliverse.github.io/settings/assets/Redirect_subject.png transparent
    - ^https:\/\/app\.bilibili\.com\/settings\/assets\/ADBlock_subject\.png(?:\?[^#]*)?$ https://biliverse.github.io/settings/assets/ADBlock_subject.png transparent
  script:
    - match: ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/(?:[a-zA-Z0-9_-]+\/?|assets\/(?:index|navigation)\.mjs)(?:\?.*)?$
      name: PreferencePanes.Web
      type: request
      require-body: false
    - match: ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/(?:get|set|delete)(?:\?.*)?$
      name: PreferencePanes.API
      type: request
      require-body: true
      max-size: 65536
    - match: ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\?.*)?$
      name: 📺 Biliverse.Enhanced.Config
      type: request
      require-body: false
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\?
      name: 📺 Biliverse.Enhanced.response
      type: response
      require-body: true
    - match: ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut$
      name: 📺 Biliverse.Enhanced.request
      type: request
      require-body: true
      binary-mode: true
    - match: ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList$
      name: 📺 Biliverse.Enhanced.response
      type: response
      require-body: true
      binary-mode: true
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\?
      name: 📺 Biliverse.Enhanced.response
      type: response
      require-body: true
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\?
      name: 📺 Biliverse.Enhanced.response
      type: response
      require-body: true
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\?
      name: 📺 Biliverse.Enhanced.response
      type: response
      require-body: true

script-providers:
  PreferencePanes.Web:
    url: https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/web.js
    interval: 86400
  PreferencePanes.API:
    url: https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js
    interval: 86400
  📺 Biliverse.Enhanced.Config:
    url: https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/config.bundle.js
    interval: 86400
  📺 Biliverse.Enhanced.request:
    url: https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/request.bundle.js
    interval: 86400
  📺 Biliverse.Enhanced.response:
    url: https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js
    interval: 86400
