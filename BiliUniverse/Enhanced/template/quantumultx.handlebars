#!name = {{@package 'displayName'}}
#!desc = {{inline (@package 'description')}}
#!openUrl = {{@package 'openUrl'}}
#!author = {{@package 'contributors'}}
#!homepage = {{@package 'homepage'}}
#!icon = {{@package 'icon'}}
#!category = {{@package 'organizationName'}}
#!date = {{now "yyyy-MM-dd HH:mm:ss"}}
#!version = {{version}}

#[rewrite_local]
^https:\/\/app\.bilibili\.com\/settings\/(?:index\.mjs|assets\/(?:Biliverse|Enhanced|Global|Redirect|ADBlock)_subject\.png)?(?:\?[^#]*)?$ url script-echo-response https://biliverse.github.io/settings/mock.js
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/(?:Enhanced\/?|assets\/(?:app|navigation)\.mjs)(?:\?.*)?$ url script-echo-response https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/web.js
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\/(?:get|set|delete))?\/?(?:\?.*)?$ url script-echo-response https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js
# Biliverse 本地设置
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/configs\/Enhanced(?:\?.*)?$ url script-echo-response https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/config.bundle.js
# 📺 BiliBili.Enhanced.x.resource.show.tab.v2
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\? url script-response-body https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js
# 📺 BiliBili.Enhanced.show.v1.Mixture.RegionShortcut.request.grpc
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut$ url script-request-body https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/request.bundle.js
# 📺 BiliBili.Enhanced.show.v1.Mixture.RegionList.response.grpc
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList$ url script-response-body https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js
# 📺 BiliBili.Enhanced.x.v2.account.mine
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\? url script-response-body https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js
# 📺 BiliBili.Enhanced.x.v2.region.index
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\? url script-response-body https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js
# 📺 BiliBili.Enhanced.x.v2.channel.region.list
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\? url script-response-body https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js

#[mitm]
hostname = biliverse.github.io, app.bilibili.com, app.biliapi.net, grpc.biliapi.net
