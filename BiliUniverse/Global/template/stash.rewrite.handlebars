name: "{{@package 'displayName'}} (Rewrite)"
desc: "{{inline (@package 'description')}}"
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
http:
  mitm:
    - "biliverse.github.io"
    - "www.bilibili.com"
    - "search.bilibili.com"
    - "app.bilibili.com"
    - "app.biliapi.net"
    - "api.bilibili.com"
    - "api.biliapi.net"
    - "grpc.biliapi.net"
  url-rewrite:
    - ^https?:\/\/(www\.bilibili\.com)\/(bangumi\/play\/(?:ss|ep)\d+\/?.*)$ https:\/\/\{{{endpoint}}}\/$1\/$2 transparent
    - ^https?:\/\/((?:grpc|app)\.bili(?:bili\.com|api\.net))\/(bilibili\/(?:app\/viewunite\/v1\/View\/View|app\/playerunite\/v1\/Player\/PlayViewUnite|pgc\/gateway\/player\/v2\/PlayURL\/PlayView|polymer\/app\/search\/v1\/Search\/(?:SearchAll|SearchByType)).*)$ https:\/\/\{{{endpoint}}}\/$1\/$2 transparent
    - ^https?:\/\/(api\.bili(?:bili\.com|api\.net))\/((?:pgc\/(?:view\/(?:v2\/app|web|pc)\/(?:season|ep\/list)|player\/(?:api|web)\/playurl(?:\/html5)?|player\/web\/v2\/playurl)|x\/(?:web-interface\/(?:wbi\/)?search\/(?:all\/v2|type)|space\/(?:wbi\/)?acc\/info)).*)$ https:\/\/\{{{endpoint}}}\/$1\/$2 transparent
    - ^https?:\/\/(app\.bili(?:bili\.com|api\.net))\/(x\/v2\/(?:search(?:\/type)?|space).*)$ https:\/\/\{{{endpoint}}}\/$1\/$2 transparent
    - ^https?:\/\/(search\.bilibili\.com)\/(all.*)$ https:\/\/\{{{endpoint}}}\/$1\/$2 transparent
